# Copy to .env.local for local dev, or set these in Netlify's env config
# for the deployed build.

VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Leave empty (or omit) for local dev - Vite's dev server proxies /api to
# http://127.0.0.1:8000 (see vite.config.js), so relative paths just work.
#
# Set this only for a deployed build where the frontend (Netlify) and
# backend (a separate Hugging Face Space) are different origins, e.g.:
# VITE_API_BASE_URL=https://pilotup-hr.hf.space
VITE_API_BASE_URL=
