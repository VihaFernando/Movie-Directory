# Copy this file to .env and fill in the real target site.
# .env is gitignored - never commit the real URL/selectors here.

MOVIEDIR_TARGET_BASE_URL=https://the-real-site.example

# Optional second catalog source:
# MOVIEDIR_BINGEFLIX_BASE_URL=https://bingeflix.tv
# MOVIEDIR_BINGEFLIX_EMBED_HOSTS=["vidfast.pro","vidfast.vc"]
# MOVIEDIR_BINGEFLIX_EMBED_URL_PATTERNS=["vidfast.pro/movie/","vidfast.pro/tv/","vidfast.vc/movie/","vidfast.vc/tv/"]
# Optional Vidbox source. Add any rotating HLS hosts observed in its player.
# MOVIEDIR_VIDBOX_BASE_URL=https://vidbox.vc
# MOVIEDIR_VIDBOX_EMBED_HOSTS=["epexegesisengine.site","vidapi.cloud","cloudorchestranova.com","ythd.org"]
# MOVIEDIR_VIDBOX_EMBED_URL_PATTERNS=[".m3u8",".mp4"]

# Only needed if the catalog isn't at the site root or selectors differ:
# MOVIEDIR_CATALOG_PATH=/browse
# MOVIEDIR_DETAIL_PATH_TEMPLATE=/movie/{slug}/
# MOVIEDIR_CATALOG_ITEM_SELECTOR=.list-movie .col
# MOVIEDIR_LINK_SELECTOR=a.poster
# MOVIEDIR_TITLE_SELECTOR=.item-title
# MOVIEDIR_THUMBNAIL_SELECTOR=picture img
# MOVIEDIR_PLAY_BUTTON_SELECTOR=a.d-block.cover

# Embed/CDN host(s) once you know them from /api/get_embed - comma-separated,
# parsed as a tuple by pydantic-settings:
# MOVIEDIR_ALLOWED_EMBED_HOSTS=["cdn.example.com","player.example.net"]

# Poster/thumbnail image host(s) for /api/proxy_image. Separate, narrower
# allowlist than the embed hosts. Include any resizing/CDN wrapper the
# catalog's <img> tags actually point at (e.g. wsrv.nl wrapping tmdb), not
# just the origin the wrapper fetches from - the proxy sees the wrapper URL.
# MOVIEDIR_ALLOWED_IMAGE_HOSTS=["image.tmdb.org","wsrv.nl"]
